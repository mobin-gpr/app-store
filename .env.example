# =============================================================================
# Django App Store - Environment Variables Configuration
# =============================================================================
# Copy this file to .env and update with your actual values
# Never commit .env to version control!

# =============================================================================
# ENVIRONMENT SETTINGS
# =============================================================================
# Options: development, production
DJANGO_ENV=development

# =============================================================================
# DJANGO CORE SETTINGS
# =============================================================================
# SECURITY WARNING: Generate a secure secret key for production!
# You can generate one using: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=your-secret-key-here-change-this-in-production

# Debug mode - MUST be False in production
DEBUG=True

# Comma-separated list of allowed hosts
# Development: localhost,127.0.0.1
# Production: yourdomain.com,www.yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1

# =============================================================================
# DATABASE SETTINGS
# =============================================================================
# Database Engine
# Development: django.db.backends.sqlite3
# Production: django.db.backends.postgresql
DB_ENGINE=django.db.backends.sqlite3

# Database Name
# SQLite: Full path or relative path (e.g., db.sqlite3)
# PostgreSQL: Database name (e.g., appstore_db)
DB_NAME=db.sqlite3

# Database User (PostgreSQL only)
DB_USER=

# Database Password (PostgreSQL only)
DB_PASSWORD=

# Database Host (PostgreSQL only)
# localhost or IP address
DB_HOST=

# Database Port (PostgreSQL only)
# Default PostgreSQL port: 5432
DB_PORT=

# Connection max age (seconds) - for PostgreSQL
DB_CONN_MAX_AGE=600

# =============================================================================
# EMAIL SETTINGS
# =============================================================================
# Email backend
# Development: django.core.mail.backends.console.EmailBackend
# Production: django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# SMTP Settings (for production)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# =============================================================================
# SECURITY SETTINGS (Production)
# =============================================================================
# SSL/HTTPS Settings
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# =============================================================================
# CORS SETTINGS
# =============================================================================
# Allow all origins (development only!)
CORS_ORIGIN_ALLOW_ALL=True

# Whitelist of allowed origins (comma-separated)
# Development: http://localhost:8000,http://127.0.0.1:8000
# Production: https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGIN_WHITELIST=http://localhost:8000,http://127.0.0.1:8000

# CSRF Trusted Origins (production)
# Format: https://yourdomain.com,https://www.yourdomain.com
CSRF_TRUSTED_ORIGINS=

# =============================================================================
# CACHE SETTINGS (Production - Redis)
# =============================================================================
# Redis URL for caching
# Format: redis://127.0.0.1:6379/1
REDIS_URL=redis://127.0.0.1:6379/1

# =============================================================================
# AWS S3 SETTINGS (Optional - for media files storage)
# =============================================================================
# Enable S3 storage for media files
USE_S3=False

# AWS Credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1

# =============================================================================
# ADMIN SETTINGS
# =============================================================================
# Custom admin URL for security (production)
# Default: admin/
# Example: secret-admin-panel/
ADMIN_URL=admin/

# =============================================================================
# RATE LIMITING (Production)
# =============================================================================
# Enable rate limiting
RATELIMIT_ENABLE=False

# =============================================================================
# SOCIAL AUTHENTICATION (django-allauth)
# =============================================================================
# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# =============================================================================
# MONITORING & ERROR TRACKING (Production)
# =============================================================================
# Sentry DSN for error tracking
SENTRY_DSN=

# =============================================================================
# DEVELOPMENT TOOLS
# =============================================================================
# Enable Django Debug Toolbar (development only)
ENABLE_DEBUG_TOOLBAR=True
